{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report_generated.schema.json",
  "title": "ReportGenerated",
  "type": "object",
  "required": ["event_id", "event_type", "correlation_id", "created_at", "version", "payload"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "const": "ReportGenerated" },
    "correlation_id": { "type": "string" },
    "created_at": { "type": "string" },
    "version": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["task_id", "report_path"],
      "properties": {
        "task_id": { "type": "string" },
        "report_id": { "type": ["string", "null"] },
        "report_path": { "type": "string" },
        "report_format": { "type": ["string", "null"] },
        "storage_uri": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
