{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk_analysis_completed.schema.json",
  "title": "RiskAnalysisCompleted",
  "type": "object",
  "required": ["event_id", "event_type", "correlation_id", "created_at", "version", "payload"],
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "const": "RiskAnalysisCompleted" },
    "correlation_id": { "type": "string" },
    "created_at": { "type": "string" },
    "version": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["task_id", "report_id", "risk_count", "status"],
      "properties": {
        "task_id": { "type": "string" },
        "report_id": { "type": "string" },
        "risk_count": { "type": "integer", "minimum": 0 },
        "high_risk_count": { "type": "integer", "minimum": 0 },
        "validation_status": { "type": "string" },
        "revision_count": { "type": "integer", "minimum": 0 },
        "status": { "const": "completed" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
